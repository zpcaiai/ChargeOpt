# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=info

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank to run in in-memory mode (Vercel / local demo)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10
# Set to 1 to skip running migrations on startup (e.g. read-only replicas)
CHARGEOPT_SKIP_DB_MIGRATION=1

# ── Security ──────────────────────────────────────────────────────────────────
# Leave blank only for local development. Production should use either
# X-API-Key or /api/v1/auth/login bearer sessions.
API_KEY=
API_KEY_HEADER=X-API-Key
CRON_SECRET=replace-with-at-least-32-random-bytes
MARKET_WEBHOOK_SECRET=replace-with-an-independent-signing-secret
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=*

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true

# ── Edge Worker ───────────────────────────────────────────────────────────────
# Worker posts claimed dispatch tasks to the authenticated site gateway.
EDGE_GATEWAY_URL=https://edge-gateway.example.com/chargeopt/tasks/execute
EDGE_GATEWAY_TOKEN=
WORKER_POLL_INTERVAL_SECONDS=5

# ── VPP Trading Autopilot ────────────────────────────────────────────────────
VPP_AUTOMATION_ENABLED=false
VPP_MAX_ORDERS_PER_CYCLE=8
CHARGEOPT_REQUIRE_EXACT_SOLVER=true
# Optional separately hosted time-series foundation model. Requests are made
# only when an EMS caller explicitly enables use_foundation_model.
CHARGEOPT_TSF_ENDPOINT=
CHARGEOPT_TSF_TOKEN=
CHARGEOPT_TSF_MODEL=chronos-2
# Live market connection rows reference this prefix through credential_ref.
# For credential_ref=CHARGEOPT_MARKET configure both variables below.
CHARGEOPT_MARKET_TOKEN=
CHARGEOPT_MARKET_SIGNING_SECRET=
